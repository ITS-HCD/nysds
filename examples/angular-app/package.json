{
  "name": "nysds-example-angular-app",
  "version": "0.0.0",
  "private": true,
  "description": "Angular standalone example app exercising @nysds/angular.",
  "scripts": {
    "prebuild": "node scripts/sync-signal-forms.mjs",
    "build": "ng build && ng build --configuration production,zoneless",
    "predev": "node scripts/sync-signal-forms.mjs",
    "dev": "ng serve",
    "test": "playwright test",
    "test:zoneless": "APP_DIST=dist/app-zoneless/browser playwright test"
  },
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@nysds/angular": "*",
    "@nysds/styles": "*",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@nysds/example-shared-tests": "*",
    "@playwright/test": "^1.61.0",
    "typescript": "^5.9.3"
  }
}
