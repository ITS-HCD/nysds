/** Detail for the `nys-change` event. */
export interface Nys{{capitalize componentName}}ChangeDetail {
  /** The component's `id`. */
  id: string;
{{#if (eq formControl "value")}}
  /** The committed value. */
  value: string;
{{/if}}
{{#if (eq formControl "checked")}}
  /** Whether the control is checked. */
  checked: boolean;
{{/if}}
{{#if (eq formControl "files")}}
  /** Currently selected files, or `null` when empty. */
  files: FileList | null;
  /** Files added or removed by the action that fired this event. */
  changedFiles: File[];
{{/if}}
}

/** Fired when the {{#if (eq formControl "value")}}value is committed{{/if}}{{#if (eq formControl "checked")}}checked state changes{{/if}}{{#if (eq formControl "files")}}selected files change{{/if}}. */
export type Nys{{capitalize componentName}}ChangeEvent = CustomEvent<Nys{{capitalize componentName}}ChangeDetail>;
{{#if (eq formControl "value")}}
/** Detail for the `nys-input` event. */
export interface Nys{{capitalize componentName}}InputDetail {
  /** The component's `id`. */
  id: string;
  /** The current value. */
  value: string;
}

/** Fired once per user input, before the value is committed. */
export type Nys{{capitalize componentName}}InputEvent = CustomEvent<Nys{{capitalize componentName}}InputDetail>;
{{/if}}
