{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.scss",
        "src/**/*.json",
        "vite.config.js",
        "vite.config.ts",
        "tsconfig.json",
        "terrazzo.config.js",
        // Framework wrappers are generated from the manifest; a manifest
        // change must invalidate their build cache (framework-support WS0).
        "$TURBO_ROOT$/custom-elements.json",
        // The Angular staging project is generated alongside the wrapper
        // sources but sits outside src/, so it needs its own input glob.
        ".ngbuild/**"
      ],
      "outputs": ["dist/**", ".tsbuildinfo"],
      "env": ["NODE_ENV", "BUILD_FORMAT"],
      "outputLogs": "new-only"
    },
    "generate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
