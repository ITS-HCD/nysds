+        outline-offset: 2px;
+      }
+
+      /* Disabled link (aria-disabled + tabindex="-1") */
+      &[aria-disabled="true"] {
+        cursor: not-allowed;
+        color: var(--nys-color-text-disabled, #cec0c1);
+
