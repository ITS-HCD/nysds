+    list-style: none;
+    max-width: var(--_nys-breadcrumbs-max-width--content);
+    width: 100%;
+  }
+
+  li {
+    margin: 0;
+  }
+
+  .nys-breadcrumbitem {
+    padding: 0;
+    display: flex;
+    align-items: center;
+    gap: var(--_nys-breadcrumbitem-gap);
+    color: var(--_nys-breadcrumbitem-color);
+    font-family: var(--_nys-breadcrumbs-font-family);
+    font-size: var(--_nys-breadcrumbs-font-size);
+    font-weight: var(--_nys-breadcrumbs-font-weight--current);
+    line-height: var(--_nys-breadcrumbs-line-height);
+    white-space: nowrap;
+
+    &.hide {
+      display: none;
+    }
+
+    a {
+      text-decoration: none;
+      color: var(--_nys-breadcrumbitem-color);
+      font-family: var(--_nys-breadcrumbs-font-family);
+      font-size: var(--_nys-breadcrumbs-font-size);
+      font-weight: var(--_nys-breadcrumbs-font-weight);
+      line-height: var(--_nys-breadcrumbs-line-height);
+
+      &:visited {
+        color: var(--_nys-breadcrumbitem-color);
+      }
+
+      &:hover {
+        color: var(--_nys-breadcrumbitem-color);
+        text-decoration-line: underline;
+        text-decoration-style: solid;
+        text-decoration-skip-ink: auto;
+        text-decoration-thickness: 14%; /* 2.24px */
+        text-underline-offset: auto;
+      }
+
+      &:active {
+        color: var(--nys-color-text);
+        text-decoration-thickness: 14%; /* 2.24px */
+      }
+
+      &:focus-visible {
+        border-radius: var(--_nys-breadcrumbitem-outline-radius);
+        outline: var(--_nys-breadcrumbitem-outline-width) solid
