diff --git a/framework-examples/vue-vite/tsconfig.json b/framework-examples/vue-vite/tsconfig.json
new file mode 100644
index 00000000..df94891d
--- /dev/null
+++ b/framework-examples/vue-vite/tsconfig.json
@@ -0,0 +1,24 @@
+{
+  "compilerOptions": {
+    "target": "ES2022",
+    "lib": ["ES2022", "DOM", "DOM.Iterable"],
+    "module": "ESNext",
+    "moduleResolution": "bundler",
+    "jsx": "preserve",
+    "strict": true,
+    "skipLibCheck": true,
+    "isolatedModules": true,
+    "noEmit": true,
+    "types": ["vite/client"],
+    "baseUrl": ".",
+    "paths": {
+      // Force one copy of the Vue types program-wide. When CI pins Vue 3.4
+      // in this workspace, the nested copy must win over the hoisted one
+      // that @nysds/vue and vue-router resolve otherwise (two copies break
+      // `app.use(router)` and the `GlobalComponents` augmentation); when
+      // nothing is nested, TypeScript falls back to normal lookup.
+      "vue": ["./node_modules/vue"]
+    }
+  },
+  "include": ["src"]
+}
diff --git a/framework-examples/vue-vite/vite.config.ts b/framework-examples/vue-vite/vite.config.ts
new file mode 100644
index 00000000..264dae8b
--- /dev/null
+++ b/framework-examples/vue-vite/vite.config.ts
@@ -0,0 +1,23 @@
+import { defineConfig } from "vite";
+import vue from "@vitejs/plugin-vue";
+
+export default defineConfig({
+  plugins: [
+    vue({
+      template: {
+        compilerOptions: {
+          // The raw-tag form variant renders <nys-*> elements directly.
+          // The @nysds/vue wrappers are ordinary components and need no
+          // such rule.
+          isCustomElement: (tag) => tag.startsWith("nys-"),
+        },
+      },
+    }),
+  ],
+  resolve: {
+    // One Vue copy, whatever the monorepo hoists elsewhere. Matters when
+    // CI pins Vue 3.4 in this workspace while a sibling package brings
+    // Vue 3.5.
+    dedupe: ["vue"],
+  },
+});
