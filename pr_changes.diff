+            <h2 id="glance">At a glance</h2>
+          </div>
+          <div class="nys-grid-col-12 nys-desktop:nys-grid-col-10">
+            <div id="notes"></div>
+            <div class="counts nys-grid-row nys-grid-gap-200">
