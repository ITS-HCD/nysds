+/**
+ * Types for `core.mjs`. Hand-written; keep in sync with the implementation.
+ * The TypeScript public API re-exports these, so this file is the single
+ * place the metadata types are declared.
+ */
+
+export declare const NYS_PREFIX: string;
+export declare const NYS_BLUR_EVENT: string;
+
+export interface FormControlMeta {
+  kind: "value" | "checked" | "files";
+  changeEvent: string;
+  inputEvent?: string;
+}
+
+export interface PropMeta {
+  name: string;
+  attribute?: string;
+  type: string;
+  default?: string;
+  description?: string;
+  isBoolean: boolean;
+  isNumber: boolean;
+  isPrimitive: boolean;
+}
+
+export interface EventMeta {
+  name: string;
+  typeText: string;
+  reactProp: string;
+  angularOutput: string;
+  description?: string;
+}
+
+export interface SlotMeta {
+  name: string;
+  description?: string;
+}
+
+export interface ComponentMeta {
+  tag: string;
+  className: string;
+  packageName: string;
+  subpath: string;
+  modulePath: string;
+  description?: string;
+  props: PropMeta[];
+  events: EventMeta[];
+  slots: SlotMeta[];
+  formControl?: FormControlMeta;
+}
+
+export interface ManifestModule {
+  path: string;
+  declarations?: unknown[];
+  [key: string]: unknown;
+}
+
+export interface Manifest {
+  modules: ManifestModule[];
+  [key: string]: unknown;
+}
+
+export declare function pascalize(name: string): string;
+export declare function tagToClass(tag: string, manifest?: Manifest): string;
+export declare function classToAngularClass(className: string): string;
+export declare function eventToReactProp(eventName: string): string;
+export declare function eventToAngularOutput(eventName: string): string;
+export declare function tagToSubpath(tag: string): string;
+export declare function tagToPackage(modulePath: string): string;
+
+export declare function isPublicMember(member: unknown): boolean;
+export declare function isPublicProp(member: unknown): boolean;
+export declare function isExposedEvent(event: unknown): boolean;
+
+export declare function parseFormControlTag(comment: string): FormControlMeta;
+
+export declare function normalizeTypeText(text: unknown): string | undefined;
+export declare function listComponents(manifest: Manifest): ComponentMeta[];
diff --git a/packages/codegen/cem-plugins/lib/core.mjs b/packages/codegen/cem-plugins/lib/core.mjs
new file mode 100644
index 00000000..60af3b53
--- /dev/null
+++ b/packages/codegen/cem-plugins/lib/core.mjs
@@ -0,0 +1,288 @@
+/**
+ * Shared rules for NYSDS code generation.
+ *
+ * This module is the single source of truth for naming rules, member and
+ * event filters, `@formControl` parsing, package derivation, and component
+ * metadata. It is plain JavaScript so the CEM plugins can run before
+ * `@nysds/codegen` is built. The TypeScript sources in `src/manifest/`
+ * re-export from this file and add no logic of their own; `core.d.mts`
+ * carries the types.
+ */
+
+/** Prefix shared by every NYSDS custom element tag. */
+export const NYS_PREFIX = "nys-";
+
+/** Event that marks a form control as touched in framework wrappers. */
+export const NYS_BLUR_EVENT = `${NYS_PREFIX}blur`;
+
+// ---------------------------------------------------------------------------
+// Naming rules (README.md section 4.1 is normative)
+// ---------------------------------------------------------------------------
+
+/**
+ * Mechanical PascalCase of a tag. Inner capitals in a segment are kept.
+ * Use `tagToClass` with a manifest when the real class name matters:
+ * class names in the manifest can capitalize differently.
+ */
+export function pascalize(name) {
+  return name
+    .split("-")
+    .map((part) => (part ? part[0].toUpperCase() + part.slice(1) : part))
+    .join("");
+}
+
+/**
+ * Tag to class name. With a manifest, returns the manifest
+ * `declaration.name`, which is authoritative. Without one, falls back to
+ * mechanical PascalCase.
+ */
+export function tagToClass(tag, manifest) {
+  if (manifest) {
+    for (const component of listComponents(manifest)) {
+      if (component.tag === tag) return component.className;
+    }
+  }
+  return pascalize(tag);
+}
+
+/** Class name to Angular component class name. */
+export function classToAngularClass(className) {
+  return `${className}Component`;
+}
+
+/** Event name to React prop: `on` + PascalCase of the full event name. */
+export function eventToReactProp(eventName) {
+  return `on${pascalize(eventName)}`;
+}
+
+/** Event name to Angular output: camelCase of the full event name. */
+export function eventToAngularOutput(eventName) {
+  const parts = eventName.split("-");
+  return (
+    parts[0] +
+    parts
+      .slice(1)
+      .map((part) => (part ? part[0].toUpperCase() + part.slice(1) : part))
+      .join("")
+  );
+}
+
+/** Tag to import subpath: the tag minus the prefix. */
+export function tagToSubpath(tag) {
+  return tag.startsWith(NYS_PREFIX) ? tag.slice(NYS_PREFIX.length) : tag;
+}
+
+/**
+ * Manifest module path to package name. Derived, never a table:
+ * `packages/nys-accordion/src/nys-accordionitem.ts` -> `@nysds/nys-accordion`.
+ */
+export function tagToPackage(modulePath) {
+  const match = /(?:^|\/)packages\/([^/]+)\//.exec(modulePath);
+  if (!match) {
+    throw new Error(
+      `Cannot derive a package name from module path "${modulePath}": expected a packages/<name>/ segment.`
+    );
+  }
+  return `@nysds/${match[1]}`;
+}
+
+// ---------------------------------------------------------------------------
+// Filters
+// ---------------------------------------------------------------------------
+
+/** Lit and custom-element machinery that must never surface as a prop. */
+const LIT_INTERNAL_MEMBERS = new Set([
+  "updateComplete",
+  "isUpdatePending",
+  "hasUpdated",
+  "renderRoot",
+  "renderOptions",
+  "shadowRootOptions",
+  "elementProperties",
+  "elementStyles",
+  "styles",
+  "properties",
+  "observedAttributes",
+  "formAssociated",
+]);
+
+/**
+ * True when a manifest member is part of the public API: not static, not
+ * underscore- or hash-prefixed, not `privacy: private | protected`, not
+ * deprecated, and not Lit machinery.
+ */
+export function isPublicMember(member) {
+  if (!member || typeof member.name !== "string" || member.name.length === 0) {
+    return false;
+  }
+  if (member.static) return false;
+  if (member.name.startsWith("_") || member.name.startsWith("#")) return false;
+  if (member.privacy === "private" || member.privacy === "protected") {
+    return false;
+  }
+  if (member.deprecated) return false;
+  if (LIT_INTERNAL_MEMBERS.has(member.name)) return false;
+  return true;
+}
+
+/** True for a public, non-deprecated field. */
+export function isPublicProp(member) {
+  return member?.kind === "field" && isPublicMember(member);
+}
+
+/** True when an event should surface in wrappers and snippets. */
+export function isExposedEvent(event) {
+  if (!event || typeof event.name !== "string" || event.name.length === 0) {
+    return false;
+  }
+  if (event.deprecated) return false;
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// @formControl parsing
+// ---------------------------------------------------------------------------
+
+const FORM_CONTROL_KINDS = new Set(["value", "checked", "files"]);
+const EVENT_NAME_RE = new RegExp(`^${NYS_PREFIX}[a-z][a-zA-Z-]*$`);
+
+/**
+ * Parses the `@formControl <kind> <changeEvent> [inputEvent]` JSDoc tag
+ * body. Throws on a malformed tag; the caller adds the file path.
+ */
+export function parseFormControlTag(comment) {
+  const parts = String(comment ?? "")
+    .trim()
+    .split(/\s+/)
+    .filter(Boolean);
+  if (parts.length < 2 || parts.length > 3) {
+    throw new Error(
+      `@formControl expects "<kind> <changeEvent> [inputEvent]"; got "${String(comment ?? "").trim()}"`
+    );
+  }
+  const [kind, changeEvent, inputEvent] = parts;
+  if (!FORM_CONTROL_KINDS.has(kind)) {
+    throw new Error(
+      `@formControl kind must be "value", "checked", or "files"; got "${kind}"`
+    );
+  }
+  for (const eventName of [changeEvent, inputEvent]) {
+    if (eventName !== undefined && !EVENT_NAME_RE.test(eventName)) {
+      throw new Error(
+        `@formControl event "${eventName}" must be a ${NYS_PREFIX}* event name`
+      );
+    }
+  }
+  return inputEvent ? { kind, changeEvent, inputEvent } : { kind, changeEvent };
+}
+
+// ---------------------------------------------------------------------------
+// Component metadata
+// ---------------------------------------------------------------------------
+
+/** Collapses whitespace in a manifest type text and trims a leading pipe. */
+export function normalizeTypeText(text) {
+  if (typeof text !== "string") return undefined;
+  const collapsed = text.replace(/\s+/g, " ").replace(/^\|\s*/, "").trim();
+  return collapsed.length > 0 ? collapsed : undefined;
+}
+
+const PRIMITIVE_PARTS = new Set([
+  "string",
+  "number",
+  "boolean",
+  "null",
+  "undefined",
+]);
+
+function isPrimitiveType(typeText) {
+  if (!typeText) return false;
+  return typeText
+    .split("|")
+    .map((part) => part.trim())
+    .filter(Boolean)
+    .every(
+      (part) =>
+        PRIMITIVE_PARTS.has(part) ||
+        /^".*"$/.test(part) ||
+        /^'.*'$/.test(part) ||
+        /^-?\d+(\.\d+)?$/.test(part)
+    );
+}
+
+function isNumberType(typeText) {
+  if (!typeText) return false;
+  const parts = typeText
+    .split("|")
+    .map((part) => part.trim())
+    .filter(Boolean);
+  return (
+    parts.includes("number") &&
+    parts.every((part) => part === "number" || part === "null" || part === "undefined")
+  );
+}
+
+/**
+ * Reads every NYSDS component out of a custom elements manifest and returns
+ * uniform metadata: naming, public props, exposed events, slots, and the
+ * `formControl` block when the manifest carries one. Sorted by tag.
+ */
+export function listComponents(manifest) {
+  const components = [];
+  for (const mod of manifest?.modules ?? []) {
+    for (const decl of mod.declarations ?? []) {
+      if (decl.kind !== "class") continue;
+      const tag = decl.tagName;
+      if (typeof tag !== "string" || !tag.startsWith(NYS_PREFIX)) continue;
+
+      const attributeByField = new Map();
+      for (const attr of decl.attributes ?? []) {
+        if (attr.fieldName && attr.name) {
+          attributeByField.set(attr.fieldName, attr.name);
+        }
+      }
+
+      const props = (decl.members ?? []).filter(isPublicProp).map((member) => {
+        const type = normalizeTypeText(member.type?.text);
+        return {
+          name: member.name,
+          attribute: member.attribute ?? attributeByField.get(member.name),
+          type: type ?? "unknown",
+          default: member.default,
+          description: member.description,
+          isBoolean: type === "boolean",
+          isNumber: isNumberType(type),
+          isPrimitive: isPrimitiveType(type),
+        };
+      });
+
+      const events = (decl.events ?? []).filter(isExposedEvent).map((event) => ({
+        name: event.name,
+        typeText: normalizeTypeText(event.type?.text) ?? "CustomEvent",
+        reactProp: eventToReactProp(event.name),
+        angularOutput: eventToAngularOutput(event.name),
+        description: event.description,
+      }));
+
+      const slots = (decl.slots ?? [])
+        .filter((slot) => typeof slot?.name === "string")
+        .map((slot) => ({ name: slot.name, description: slot.description }));
+
+      const component = {
+        tag,
+        className: decl.name,
+        packageName: tagToPackage(mod.path),
+        subpath: tagToSubpath(tag),
+        modulePath: mod.path,
+        description: decl.description,
+        props,
+        events,
+        slots,
+      };
+      if (decl.formControl) component.formControl = decl.formControl;
+      components.push(component);
+    }
+  }
+  components.sort((a, b) => a.tag.localeCompare(b.tag));
+  return components;
+}
diff --git a/packages/codegen/cem-plugins/react.mjs b/packages/codegen/cem-plugins/react.mjs
new file mode 100644
index 00000000..47b28227
--- /dev/null
+++ b/packages/codegen/cem-plugins/react.mjs
@@ -0,0 +1,143 @@
+/**
+ * CEM plugin: generates the `@lit/react` wrapper for every NYSDS component
+ * into `packages/react/src/generated/` (decision R1).
+ *
+ * The output directory is cleared and recreated on every run, so removed
+ * components leave no orphans. A hand-written file at
+ * `src/overrides/<ClassName>.ts` replaces the generated one: the component
+ * is skipped and the barrel re-exports the override.
+ */
+import fs from "node:fs";
+import path from "node:path";
+import { listComponents } from "./lib/core.mjs";
+
+/** Event interface names the platform provides; never imported. */
+const GLOBAL_EVENT_TYPES = new Set([
+  "Event",
+  "CustomEvent",
+  "UIEvent",
+  "FocusEvent",
+  "InputEvent",
+  "KeyboardEvent",
+  "MouseEvent",
+  "PointerEvent",
+  "TouchEvent",
+  "WheelEvent",
+  "AnimationEvent",
+  "TransitionEvent",
+  "ClipboardEvent",
+  "DragEvent",
+  "SubmitEvent",
+]);
+
+const IDENTIFIER_RE = /^[A-Za-z_$][A-Za-z0-9_$]*$/;
+
+/**
+ * Splits event types into locally usable text and package type imports.
+ * Bare identifiers that are not platform globals are assumed to be typed
+ * aliases exported by the component package (section 4.3 of the plan).
+ * Anything else — including today's bare `CustomEvent` — is used verbatim.
+ */
+export function resolveEventType(typeText) {
+  if (IDENTIFIER_RE.test(typeText) && !GLOBAL_EVENT_TYPES.has(typeText)) {
+    return { text: typeText, importName: typeText };
+  }
+  return { text: typeText, importName: undefined };
+}
+
+function renderReactWrapper(component) {
+  const { tag, className, packageName, events } = component;
+  const elementAlias = `${className}Element`;
+
+  const typeImports = new Set();
+  const eventLines = [];
+  const seenProps = new Set();
+  for (const event of events) {
+    // Two event names can map to one React prop (a deprecated camelCase
+    // alias like `nys-fileRemove` next to `nys-file-remove`). Keep the
+    // first, which is the canonical name in manifest order.
+    if (seenProps.has(event.reactProp)) continue;
+    seenProps.add(event.reactProp);
+    const { text, importName } = resolveEventType(event.typeText);
+    if (importName) typeImports.add(importName);
+    eventLines.push(`    ${event.reactProp}: "${event.name}" as EventName<${text}>,`);
+  }
+
+  const lines = [];
+  lines.push(`"use client";`);
+  lines.push(
+    `// GENERATED by @nysds/codegen — do not edit. Override: src/overrides/${className}.ts`
+  );
+  lines.push(`import * as React from "react";`);
+  lines.push(
+    events.length > 0
+      ? `import { createComponent, type EventName } from "@lit/react";`
+      : `import { createComponent } from "@lit/react";`
+  );
+  lines.push(
+    `import { ${className} as ${elementAlias} } from "${packageName}";`
+  );
+  if (typeImports.size > 0) {
+    lines.push(
+      `import type { ${[...typeImports].sort().join(", ")} } from "${packageName}";`
+    );
+  }
+  lines.push(``);
+  lines.push(`export const ${className} = createComponent({`);
+  lines.push(`  react: React,`);
+  lines.push(`  tagName: "${tag}",`);
+  lines.push(`  elementClass: ${elementAlias},`);
+  lines.push(`  displayName: "${className}",`);
+  if (eventLines.length > 0) {
+    lines.push(`  events: {`);
+    lines.push(...eventLines);
+    lines.push(`  },`);
+  }
+  lines.push(`});`);
+  lines.push(``);
+  lines.push(
+    `export type ${className}Props = React.ComponentProps<typeof ${className}>;`
+  );
+  lines.push(`export type { ${elementAlias} };`);
+  lines.push(``);
+  return lines.join("\n");
+}
+
+export function reactPlugin(options = {}) {
+  const {
+    outDir = "packages/react/src/generated",
+    overridesDir = "packages/react/src/overrides",
+  } = options;
+
+  return {
+    name: "nysds-react-wrappers",
+
+    packageLinkPhase({ customElementsManifest }) {
+      const components = listComponents(customElementsManifest);
+      if (components.length === 0) return;
+
+      fs.rmSync(outDir, { recursive: true, force: true });
+      fs.mkdirSync(outDir, { recursive: true });
+
+      const barrel = [
+        `// GENERATED by @nysds/codegen — do not edit.`,
+      ];
+      for (const component of components) {
+        const overridePath = path.join(
+          overridesDir,
+          `${component.className}.ts`
+        );
+        if (fs.existsSync(overridePath)) {
+          barrel.push(`export * from "../overrides/${component.className}.js";`);
+          continue;
+        }
+        fs.writeFileSync(
+          path.join(outDir, `${component.className}.ts`),
+          renderReactWrapper(component)
+        );
+        barrel.push(`export * from "./${component.className}.js";`);
+      }
+      fs.writeFileSync(path.join(outDir, "index.ts"), barrel.join("\n") + "\n");
+    },
+  };
+}
diff --git a/packages/codegen/cem-plugins/vue.mjs b/packages/codegen/cem-plugins/vue.mjs
new file mode 100644
index 00000000..6a156091
--- /dev/null
+++ b/packages/codegen/cem-plugins/vue.mjs
@@ -0,0 +1,228 @@
+/**
+ * CEM plugin: generates the Vue typings for every NYSDS component into
+ * `packages/vue/src/generated/`.
+ *
+ * Per component, `<ClassName>.ts` exports:
+ * - `<ClassName>Props`, `<ClassName>Events`: the attributes, properties and
+ *   `on<Event>` handlers a raw `<nys-*>` tag accepts.
+ * - `<ClassName>Slots`: the slot names from the manifest, typed for
+ *   `<template #name>` on the wrapper.
+ * - `<ClassName>Model` (form controls only): `modelValue` and
+ *   `onUpdate:modelValue`, derived from the `@formControl` tag.
+ * - `<ClassName>`: a Vue component (built by `createNysComponent` in
+ *   `src/runtime.ts`) that renders the element, maps slots to light-DOM
+ *   children, and supports `v-model` on form controls.
+ *
+ * Plus:
+ * - `index.ts` is the barrel.
+ * - `global.ts` augments `vue`'s `GlobalComponents` (typed `<nys-*>` in
+ *   templates via Volar / vue-tsc) and the global `JSX.IntrinsicElements`
+ *   (typed `<nys-*>` in TSX/JSX).
+ *
+ * Prop types are picked from the element class, so they stay exact even where
+ * the manifest carries only a loose type string. The output directory is
+ * cleared on every run, so removed components leave no orphans.
+ */
+import fs from "node:fs";
+import path from "node:path";
+import { listComponents } from "./lib/core.mjs";
+import { resolveEventType } from "./react.mjs";
+
+function renderVueProps(component) {
+  const { className, packageName, props, events, slots, formControl } =
+    component;
+  const elementAlias = `${className}Element`;
+  const propsName = `${className}Props`;
+
+  const typeImports = new Set();
+  const eventLines = [];
+  const seenProps = new Set();
+  for (const event of events) {
+    // Vue camelizes `@nys-change` to `onNysChange`, the same shape React
+    // uses, so two event names can collide here too. Keep the first.
+    if (seenProps.has(event.reactProp)) continue;
+    seenProps.add(event.reactProp);
+    const { text, importName } = resolveEventType(event.typeText);
+    if (importName) typeImports.add(importName);
+    if (event.description) {
+      eventLines.push(
+        `  /** ${event.description.replace(/\s*\n\s*/g, " ").replace(/\*\//g, "*\\/")} */`
+      );
+    }
+    eventLines.push(`  ${event.reactProp}?: (event: ${text}) => void;`);
+  }
+
+  const propNames = [...new Set(props.map((prop) => prop.name))].sort();
+  const propsType =
+    propNames.length > 0
+      ? `Partial<Pick<${elementAlias}, ${propNames.map((n) => JSON.stringify(n)).join(" | ")}>>`
+      : `{}`;
+
+  const lines = [];
+  lines.push(
+    `// GENERATED by @nysds/codegen — do not edit. Regenerate with \`npm run cem\`.`
+  );
+  lines.push(
+    `import type { ${className} as ${elementAlias}${[...typeImports].sort().map((n) => `, ${n}`).join("")} } from "${packageName}";`
+  );
+  lines.push(`import "${packageName}";`);
+  lines.push(`import type { HTMLAttributes, ReservedProps } from "vue";`);
+  lines.push(
+    `import { createNysComponent, type NysComponent, type NysSlots } from "../runtime.js";`
+  );
+  lines.push(``);
+  lines.push(`/** Handlers for the events \`<${component.tag}>\` dispatches. */`);
+  lines.push(`export interface ${className}Events {`);
+  lines.push(...eventLines);
+  lines.push(`}`);
+  lines.push(``);
+  lines.push(`type ${className}Members = ${propsType};`);
+  lines.push(``);
+  lines.push(
+    `/** Everything \`<${component.tag}>\` accepts in a Vue template or TSX file. */`
+  );
+  lines.push(`export type ${propsName} = Omit<`);
+  lines.push(`  HTMLAttributes,`);
+  lines.push(`  keyof ${className}Members | keyof ${className}Events`);
+  lines.push(`> &`);
+  lines.push(`  ReservedProps &`);
+  lines.push(`  ${className}Members &`);
+  lines.push(`  ${className}Events;`);
+  lines.push(``);
+  lines.push(`export type { ${elementAlias} };`);
+  lines.push(``);
+
+  // Slots: "" is the default slot. The default slot is always allowed: some
+  // elements take children without documenting one in the manifest.
+  const slotKeys = [
+    ...new Set(["default", ...slots.map((slot) => slot.name || "default")]),
+  ].sort();
+  lines.push(
+    `/** Slots of \`<${component.tag}>\`, fillable with \`<template #name>\` on the wrapper. */`
+  );
+  lines.push(
+    `export type ${className}SlotName = ${slotKeys.map((n) => JSON.stringify(n)).join(" | ")};`
+  );
+  lines.push(
+    `export type ${className}Slots = NysSlots<${className}SlotName>;`
+  );
+  lines.push(``);
+
+  // v-model: only where the manifest declares a form contract.
+  let modelType = "";
+  if (formControl) {
+    const modelValueType = `${elementAlias}[${JSON.stringify(formControl.kind)}]`;
+    lines.push(
+      `/** \`v-model\` binds \`${formControl.kind}\`; add \`.lazy\` to update on \`${formControl.changeEvent}\`. */`
+    );
+    lines.push(`export interface ${className}Model {`);
+    lines.push(`  modelValue?: ${modelValueType};`);
+    lines.push(
+      `  "onUpdate:modelValue"?: (value: ${modelValueType}) => void;`
+    );
+    lines.push(`}`);
+    lines.push(``);
+    modelType = ` & ${className}Model`;
+  }
+
+  // Runtime wrapper.
+  const booleanProps = [
+    ...new Set(props.filter((prop) => prop.isBoolean).map((prop) => prop.name)),
+  ].sort();
+  lines.push(`export const ${className} = createNysComponent<`);
+  lines.push(
+    `  NysComponent<${propsName}${modelType}, ${className}Slots, ${elementAlias}>`
+  );
+  lines.push(`>({`);
+  lines.push(`  tag: "${component.tag}",`);
+  lines.push(`  name: "${className}",`);
+  lines.push(`  props: ${JSON.stringify(propNames)},`);
+  lines.push(`  booleanProps: ${JSON.stringify(booleanProps)},`);
+  if (formControl) {
+    const listener = (name) =>
+      events.find((event) => event.name === name)?.reactProp;
+    const changeListener = listener(formControl.changeEvent);
+    const inputListener = formControl.inputEvent
+      ? listener(formControl.inputEvent)
+      : undefined;
+    lines.push(`  model: {`);
+    lines.push(`    kind: "${formControl.kind}",`);
+    lines.push(`    changeListener: "${changeListener}",`);
+    if (inputListener) lines.push(`    inputListener: "${inputListener}",`);
+    lines.push(`  },`);
+  }
+  lines.push(`});`);
+  lines.push(``);
+  return lines.join("\n");
+}
+
+function renderGlobal(components) {
+  const lines = [];
+  lines.push(`// GENERATED by @nysds/codegen — do not edit.`);
+  lines.push(`import type { DefineComponent } from "vue";`);
+  // A module augmentation only resolves if the program already loads the
+  // module; this import guarantees it does.
+  lines.push(`import type {} from "vue/jsx-runtime";`);
+  for (const c of components) {
+    lines.push(`import type { ${c.className}Props } from "./${c.className}.js";`);
+  }
+  lines.push(``);
+  lines.push(`declare module "vue" {`);
+  lines.push(`  /** Typed \`<nys-*>\` tags in Vue templates (Volar / vue-tsc). */`);
+  lines.push(`  interface GlobalComponents {`);
+  for (const c of components) {
+    lines.push(`    "${c.tag}": DefineComponent<${c.className}Props>;`);
+  }
+  lines.push(`  }`);
+  lines.push(`}`);
+  lines.push(``);
+  // Vue exposes JSX two ways: the global namespace (`vue/jsx`) and the
+  // `vue/jsx-runtime` module (`jsxImportSource: "vue"`). Augment both.
+  for (const [open, close, indent] of [
+    ["declare module \"vue/jsx-runtime\" {", "}", "  "],
+    ["declare global {", "}", "  "],
+  ]) {
+    lines.push(open);
+    lines.push(`${indent}namespace JSX {`);
+    lines.push(`${indent}  /** Typed \`<nys-*>\` tags in TSX / JSX. */`);
+    lines.push(`${indent}  interface IntrinsicElements {`);
+    for (const c of components) {
+      lines.push(`${indent}    "${c.tag}": ${c.className}Props;`);
+    }
+    lines.push(`${indent}  }`);
+    lines.push(`${indent}}`);
+    lines.push(close);
+    lines.push(``);
+  }
+  lines.push(`export {};`);
+  lines.push(``);
+  return lines.join("\n");
+}
+
+export function vuePlugin(options = {}) {
+  const { outDir = "packages/vue/src/generated" } = options;
+
+  return {
+    name: "nysds-vue-types",
+
+    packageLinkPhase({ customElementsManifest }) {
+      const components = listComponents(customElementsManifest);
+      if (components.length === 0) return;
+
+      fs.rmSync(outDir, { recursive: true, force: true });
+      fs.mkdirSync(outDir, { recursive: true });
+
+      const barrel = [`// GENERATED by @nysds/codegen — do not edit.`];
+      for (const component of components) {
+        fs.writeFileSync(
+          path.join(outDir, `${component.className}.ts`),
+          renderVueProps(component)
+        );
+        barrel.push(`export * from "./${component.className}.js";`);
+      }
+      barrel.push(`import "./global.js";`);
+      fs.writeFileSync(path.join(outDir, "global.ts"), renderGlobal(components));
+      fs.writeFileSync(path.join(outDir, "index.ts"), barrel.join("\n") + "\n");
+    },
+  };
+}
diff --git a/packages/codegen/package.json b/packages/codegen/package.json
new file mode 100644
index 00000000..c1dc193d
--- /dev/null
+++ b/packages/codegen/package.json
@@ -0,0 +1,48 @@
+{
+  "name": "@nysds/codegen",
+  "version": "1.22.1",
+  "description": "Manifest readers, naming rules, CEM plugins, and the HTML snippet transformer for NYSDS framework support.",
