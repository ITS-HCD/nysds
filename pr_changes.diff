+    opacity: 0.4;
+    pointer-events: none;
+
+    &:hover {
+      text-decoration: none;
+    }
+  }
+}
+
+/** RTL support **/
+[dir="rtl"] nys-breadcrumbs nys-icon {
+  transform: scaleX(-1);
+}
