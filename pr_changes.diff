+    const input = el.shadowRoot!.querySelector("input")!;
+    let received = false;
+    el.addEventListener("nys-input", () => {
+      received = true;
+    });
+
+    dispatchNysEvent(input, "nys-input", { id: "a", value: "c" });
+
+    expect(received).to.be.true;
+  });
+});
+
+describe("dispatchNysFocusBlur", () => {
