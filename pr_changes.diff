+    <!-- A script rather than JSON, so the page also works opened from disk. -->
+    <script src="review-data.js"></script>
+    <script>
+      // Renders the review from review-data.js (window.REVIEW_DATA), written
+      // next to this page by review-codegen.mjs. Every value from it is
+      // escaped; file paths and command-line flags are set as code.
+
+      const data = window.REVIEW_DATA;
+
+      /** How each verdict reads on the page, as an nys-badge. */
+      const BADGES = {
+        expected: { intent: "success", label: "Expected" },
+        generator: { intent: "info", label: "Generator" },
+        check: { intent: "warning", label: "Check" },
+      };
+
+      const HTML_ESCAPES = {
+        "&": "&amp;",
+        "<": "&lt;",
+        ">": "&gt;",
+        '"': "&quot;",
+        "'": "&#39;",
+      };
+
+      function escapeHtml(value) {
+        return String(value).replace(/[&<>"']/g, (char) => HTML_ESCAPES[char]);
+      }
+
+      function plural(count, noun) {
+        return `${count} ${noun}${count === 1 ? "" : "s"}`;
+      }
+
+      /** A file path as code that can wrap after a slash, never mid-name. */
+      function pathHtml(file) {
+        return `<code>${escapeHtml(file).replaceAll("/", "/<wbr>")}</code>`;
+      }
+
+      /** Escapes text and sets the file paths and command-line flags in it as code. */
+      function withPaths(text) {
+        return escapeHtml(text).replace(
+          /(?:packages|src)\/[^\s,]+|package-lock\.json|--[a-z][a-z-]*/g,
+          (match) =>
+            match.startsWith("--")
+              ? `<code class="flag">${match}</code>`
+              : `<code>${match.replaceAll("/", "/<wbr>")}</code>`,
+        );
+      }
+
+      /** Escapes text and sets its `backtick` spans as code, as GitHub titles do. */
+      function inlineCode(text) {
+        return escapeHtml(text).replace(/`([^`]+)`/g, "<code>$1</code>");
+      }
+
+      function capitalize(text) {
+        return text[0].toUpperCase() + text.slice(1);
+      }
+
+      function badgeHtml(verdict) {
+        const { intent, label } = BADGES[verdict];
+        return `<nys-badge intent="${intent}" label="${label}" size="sm"></nys-badge>`;
+      }
+
+      /** One side of what produced a file: a plugin and its source, or an override. */
+      function producerHtml(producer) {
+        if (producer.verb === "override") {
+          return `Override ${pathHtml(producer.file)} <span class="weak">(hand-written)</span>`;
+        }
+        const from = producer.from
+          ? `<br>from ${withPaths(producer.from)}`
+          : `<br><span class="weak">Shared file: barrel, module, or package config</span>`;
+        return `${capitalize(producer.verb)} ${pathHtml(producer.file)}${from}`;
+      }
+
+      /** What produced a file, with "Was" and "Now" when that changed. */
+      function provenanceHtml(provenance) {
+        return provenance
+          .map((side) =>
+            side.label
+              ? `<span class="tag">${side.label}</span> ${producerHtml(side)}`
+              : producerHtml(side),
+          )
+          .join("<br>");
+      }
+
+      function reasonsHtml(reasons) {
+        if (reasons.length === 0) {
+          return "<strong>Nothing in this PR explains this change.</strong>";
+        }
+        const items = reasons.map((reason) => `<li>${withPaths(reason)}</li>`);
+        return `<ul class="plain">${items.join("")}</ul>`;
+      }
+
+      /** The `+ prop x`, `- event y`, and `~ …` lines of an API change. */
+      function apiHtml(delta) {
+        const kinds = {
+          "+": ["add", "Added"],
+          "-": ["del", "Removed"],
+          "~": ["mod", "Changed"],
+        };
+        const items = delta.map((text) => {
+          const kind = kinds[text[0]];
+          if (!kind || text[1] !== " ") return `<li>${escapeHtml(text)}</li>`;
+          const sign = text[0] === "-" ? "−" : text[0];
+          return `<li class="${kind[0]}"><span class="sign" aria-hidden="true">${sign}</span><span class="visually-hidden">${kind[1]}: </span>${escapeHtml(text.slice(2))}</li>`;
+        });
+        return `<ul class="api">${items.join("")}</ul>`;
+      }
+
+      /** Renders unified diff text as a table with old and new line numbers. */
+      function diffHtml(diff) {
+        const rows = [];
+        const codeCell = (text) => `<td class="code">${text}</td>`;
+        const emptyCells = `<td class="ln"></td><td class="ln"></td><td class="sign"></td>`;
+        let oldLine = 0;
+        let newLine = 0;
+        let inHunk = false;
+
+        for (const text of diff.split("\n")) {
+          const hunk = /^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@/.exec(text);
+          if (hunk) {
+            oldLine = Number(hunk[1]);
+            newLine = Number(hunk[2]);
+            inHunk = true;
+            rows.push(
+              `<tr class="hunk">${emptyCells}${codeCell(escapeHtml(text))}</tr>`,
+            );
+            continue;
+          }
+          if (!inHunk || text === "") continue;
+
+          const code = escapeHtml(text.slice(1));
+          if (text[0] === "+") {
+            rows.push(
+              `<tr class="add"><td class="ln"></td><td class="ln">${newLine++}</td><td class="sign">+</td>${codeCell(code)}</tr>`,
+            );
+          } else if (text[0] === "-") {
+            rows.push(
+              `<tr class="del"><td class="ln">${oldLine++}</td><td class="ln"></td><td class="sign">−</td>${codeCell(code)}</tr>`,
+            );
+          } else if (text[0] === "\\") {
+            rows.push(
+              `<tr class="note">${emptyCells}${codeCell(escapeHtml(text.slice(2)))}</tr>`,
+            );
+          } else {
+            rows.push(
+              `<tr><td class="ln">${oldLine++}</td><td class="ln">${newLine++}</td><td class="sign"></td>${codeCell(code)}</tr>`,
+            );
+          }
+        }
+        return `<table class="diff"><thead class="visually-hidden"><tr><th>Base line</th><th>Head line</th><th>Change</th><th>Code</th></tr></thead><tbody>${rows.join("")}</tbody></table>`;
+      }
+
+      // --- Header and "At a glance" -----------------------------------------
+
+      function renderHeader() {
+        document.title = `Codegen review: ${data.name}`;
+        document.querySelector("#review-name").textContent = data.name;
+        document.querySelector("#review-title").innerHTML = inlineCode(
+          data.title,
+        );
+      }
+
+      function renderGlance() {
+        if (data.notes.length > 0) {
+          const notes = data.notes.map((note) => `<li>${withPaths(note)}</li>`);
+          document.querySelector("#notes").innerHTML =
+            `<nys-alert type="info" heading="Notes about this run"><ul>${notes.join("")}</ul></nys-alert>`;
+        }
+
+        document.querySelector("#count-expected").heading = String(
+          data.counts.expected,
+        );
+        document.querySelector("#count-generator").heading = String(
+          data.counts.generator,
+        );
+        document.querySelector("#count-check").heading = String(
+          data.counts.check,
+        );
+        const apiCard = document.querySelector("#count-api");
+        apiCard.heading = String(data.counts.apiChanged);
+        apiCard.description =
+          data.counts.apiChanged === 1
+            ? "component API changed"
+            : "component APIs changed";
+
+        const { base, head, url, changedFiles, generatorChanged, filters } =
+          data.compare;
+        const facts = [
+          [
+            "Base",
+            `<code>${escapeHtml(base.sha)}</code> ${escapeHtml(base.label)}`,
+          ],
+          [
+            "Head",
+            `<code>${escapeHtml(head.sha)}</code> ${inlineCode(head.label)}`,
+          ],
+        ];
+        if (url) {
+          facts.push([
+            "Pull request",
+            `<a href="${escapeHtml(url)}">${escapeHtml(url)}</a>`,
+          ]);
+        }
+        facts.push(["Changed in this PR", plural(changedFiles, "file")]);
+        facts.push([
+          "Generator",
+          generatorChanged.length > 0
+            ? `Changed: ${generatorChanged.map(pathHtml).join(", ")}`
+            : "Unchanged",
+        ]);
+        if (filters.length > 0) {
+          facts.push(["Showing only", escapeHtml(filters.join(", "))]);
+        }
+        document.querySelector("#compare-facts").innerHTML = facts
+          .map(([term, value]) => `<dt>${term}</dt><dd>${value}</dd>`)
+          .join("");
+
+        for (const badge of document.querySelectorAll("[data-badge]")) {
+          badge.innerHTML = badgeHtml(badge.dataset.badge);
+        }
+      }
+
+      // --- Changed files ----------------------------------------------------
+
+      function fileRowHtml(file) {
+        const link = `#${file.diffId}`;
+        // Three or more files with the same change and cause share a row.
+        if (file.folder) {
+          const producer = file.producer.overrideFolder
+            ? `Overrides in ${pathHtml(file.producer.overrideFolder)}`
+            : `${capitalize(file.producer.verb)} ${pathHtml(file.producer.file)}<br><span class="weak">One file per component</span>`;
+          return `<tr><td>${badgeHtml(file.verdict)}</td><td><a href="${link}">${pathHtml(file.folder)}</a><br><span class="weak">${plural(file.fileCount, "file")}</span></td><td>${escapeHtml(file.change)}</td><td>${producer}</td><td>${reasonsHtml(file.reasons)}</td></tr>`;
+        }
+        return `<tr><td>${badgeHtml(file.verdict)}</td><td><a href="${link}">${pathHtml(file.path)}</a></td><td>${escapeHtml(file.change)}</td><td>${provenanceHtml(file.provenance)}</td><td>${reasonsHtml(file.reasons)}</td></tr>`;
+      }
+
+      function renderFiles() {
+        if (data.files.length === 0) return;
+        document.querySelector("#files-body").innerHTML = data.files
+          .map(fileRowHtml)
+          .join("");
+        document.querySelector("#files-empty").remove();
+        document.querySelector("#files-table").hidden = false;
+      }
+
+      // --- API changes and quiet components ---------------------------------
+
+      function renderApiChanges() {
+        if (data.apiChanges.length === 0) return;
+        document.querySelector("#api-content").innerHTML = data.apiChanges
+          .map(
+            (component) => `
+              <div class="component">
+                <h3><code>${escapeHtml(component.tag)}</code></h3>
+                <p class="weak">${withPaths(component.modulePaths.join(", "))}</p>
+                ${apiHtml(component.delta)}
+              </div>`,
+          )
+          .join("");
+      }
+
+      function renderQuiet() {
+        if (data.quiet.length === 0) return;
+        document.querySelector("#quiet").hidden = false;
+        document.querySelector("#quiet-content").innerHTML = data.quiet
+          .map((component) => {
+            const sources =
+              component.sources.length > 0
+                ? `<ul class="plain">${component.sources.map((source) => `<li>${withPaths(source)}</li>`).join("")}</ul>`
+                : "<p>No source change in this PR.</p>";
+            const api =
+              component.delta.length > 0
+                ? apiHtml(component.delta)
+                : '<p class="weak">API unchanged.</p>';
+            return `
+              <div class="component">
+                <h3><code>${escapeHtml(component.tag)}</code></h3>
+                ${sources}
+                ${api}
+              </div>`;
+          })
+          .join("");
+      }
+
+      // --- Diffs ------------------------------------------------------------
+
+      function diffItemHtml(item) {
+        const repeats =
+          item.same.length > 0
+            ? `<p class="repeats">Same change, component names aside, in ${plural(item.sameCount, "more file")}:</p>${item.same
+                .map(
+                  ({ folder, names }) =>
+                    `<p class="weak"><code>${escapeHtml(folder)}/</code></p><ul class="same">${names.map((name) => `<li><code>${escapeHtml(name)}</code></li>`).join("")}</ul>`,
+                )
+                .join("")}`
+            : "";
+        const apiFacts =
+          item.apiDelta.length > 0
+            ? `<dt>API</dt><dd>${apiHtml(item.apiDelta)}</dd>`
+            : "";
+        const diff = item.diff
+          ? `<div class="diff-scroll">${diffHtml(item.diff)}</div>`
+          : '<p class="weak">Same content. Only the file that provides it changed.</p>';
+        return `
+          <nys-accordionitem id="${item.id}" heading="${escapeHtml(item.heading)}"${item.expanded ? " expanded" : ""}>
+            <div class="item-body">
+              <div class="diff-meta">
+                <p>${badgeHtml(item.verdict)} <span class="weak">${escapeHtml(item.change)}</span></p>
+                <dl class="facts">
+                  <dt>Produced by</dt><dd>${provenanceHtml(item.provenance)}</dd>
+                  <dt>Why</dt><dd>${reasonsHtml(item.reasons)}</dd>
+                  ${apiFacts}
+                </dl>
+              </div>
+              ${diff}
+              ${repeats}
+            </div>
+          </nys-accordionitem>`;
+      }
+
+      function renderDiffs() {
+        if (data.diffs.length === 0) return;
+        document.querySelector("#diffs-empty").remove();
+        document.querySelector("#diffs-toolbar").hidden = false;
+        document.querySelector("#diffs-list").innerHTML =
+          `<nys-accordion bordered headingLevel="h3">${data.diffs.map(diffItemHtml).join("")}</nys-accordion>`;
+      }
+
+      function renderFooter() {
+        document.querySelector("#footer-command").textContent =
+          data.footer.command;
+        document.querySelector("#footer-generated").textContent =
+          data.footer.generated;
+        document.querySelector("#footer-seconds").textContent =
+          data.footer.seconds;
+      }
+
+      if (data) {
+        renderHeader();
+        renderGlance();
+        renderFiles();
+        renderApiChanges();
+        renderQuiet();
+        renderDiffs();
+        renderFooter();
+      } else {
+        document.querySelector("main").innerHTML =
+          "<p>No review data. Run npm run review:codegen -- --html to make one.</p>";
+      }
+    </script>
+    <!-- Behavior: summary links open their diff; expand and collapse all. -->
+    <script type="module">
+      const items = () => [...document.querySelectorAll("nys-accordionitem")];
+      const reveal = (id) => {
+        const item = document.getElementById(id);
+        if (!item) return;
+        item.expanded = true;
+        item.scrollIntoView({ block: "start" });
+      };
+      // Summary links open the diff they point to, not only scroll to it.
+      document.addEventListener("click", (event) => {
+        const link = event.target.closest('a[href^="#diff-"]');
+        if (!link) return;
+        event.preventDefault();
+        history.replaceState(null, "", link.hash);
+        reveal(link.hash.slice(1));
+      });
+      document
+        .getElementById("expand-all")
+        ?.addEventListener("nys-click", () => {
+          for (const item of items()) item.expanded = true;
+        });
+      document
+        .getElementById("collapse-all")
+        ?.addEventListener("nys-click", () => {
+          for (const item of items()) item.expanded = false;
+        });
+      if (location.hash.startsWith("#diff-")) {
+        customElements
+          .whenDefined("nys-accordionitem")
+          .then(() => reveal(location.hash.slice(1)));
+      }
+    </script>
+  </body>
+</html>
diff --git a/src/scripts/nysds-review/templates/landing.html b/src/scripts/nysds-review/templates/landing.html
new file mode 100644
index 00000000..93886dd1
--- /dev/null
+++ b/src/scripts/nysds-review/templates/landing.html
@@ -0,0 +1,156 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <meta name="robots" content="noindex, nofollow" />
+    <title>NYSDS Review Tools</title>
+    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
+    <link rel="stylesheet" href="/assets/fonts/nysds-fonts.css" />
+    <link rel="stylesheet" href="/assets/css/nysds-full.min.css" />
+    <style>
+      /* Cards in a row share one height (see nys-card's --nys-card-height). */
+      .review-tools {
+        --nys-card-height: 100%;
+      }
+    </style>
+  </head>
+  <body>
+    <!--
+      The landing page of the PR preview deploy, written to / by
+      build-preview.mjs. site-data.js (generated alongside it) says which
+      review tools this build has and summarizes each one; the script at the
+      bottom fills them in before the NYSDS components load.
+    -->
+    <nys-skipnav></nys-skipnav>
+    <nys-unavheader hideTranslate hideSearch></nys-unavheader>
+    <nys-globalheader appName="NYSDS Review" homepageLink="/">
+      <ul id="app-links">
+        <li data-app="preview">
+          <a href="/preview/">Accessibility Tests</a>
+        </li>
+        <li data-app="visual"><a href="/visual/">Visual Changes</a></li>
+        <li data-app="codeReview">
+          <a href="/code-review/">Codegen Review</a>
+        </li>
+      </ul>
+    </nys-globalheader>
+
+    <main id="main-content">
+      <!-- Widescreen, so the content lines up with the global header and footer. -->
+      <div class="nys-grid-container-widescreen nys-padding-b-600">
+        <div class="nys-grid-row">
+          <div class="nys-grid-col-12">
+            <h1>Review this change</h1>
+            <p id="pull-request" class="nys-font-body-md nys-margin-t-200">
+              Built from a local checkout.
+            </p>
+          </div>
+        </div>
+
+        <div
+          class="review-tools nys-grid-row nys-grid-gap-300 nys-margin-t-600"
+        >
+          <div
+            class="nys-grid-col-12 nys-desktop:nys-grid-col-4 nys-display-flex"
+          >
+            <nys-card
+              data-app="preview"
+              heading="Accessibility Tests"
+              description="Every story of the changed components on its own page, for testing with screen readers, keyboards, and zoom."
+              elevated
+            >
+              <nys-icon
+                slot="footer"
+                name="arrow_forward"
+                size="5xl"
+              ></nys-icon>
+            </nys-card>
+          </div>
+          <div
+            class="nys-grid-col-12 nys-desktop:nys-grid-col-4 nys-display-flex"
+          >
+            <nys-card
+              data-app="visual"
+              heading="Visual Changes"
+              description="Screenshots of every story and its hover, press and focus states, compared with the base branch."
+              elevated
+            >
+              <nys-icon
+                slot="footer"
+                name="arrow_forward"
+                size="5xl"
+              ></nys-icon>
+            </nys-card>
+          </div>
+          <div
+            class="nys-grid-col-12 nys-desktop:nys-grid-col-4 nys-display-flex"
+          >
+            <nys-card
+              data-app="codeReview"
+              heading="Codegen Review"
+              description="What this change does to the generated framework wrappers, which are gitignored and missing from the pull request diff."
+              elevated
+            >
+              <nys-icon
+                slot="footer"
+                name="arrow_forward"
+                size="5xl"
+              ></nys-icon>
+            </nys-card>
+          </div>
+        </div>
+      </div>
+    </main>
+
+    <nys-backtotop></nys-backtotop>
+    <nys-globalfooter agencyName="NYS Design System" homepageLink="/">
+    </nys-globalfooter>
+    <nys-unavfooter></nys-unavfooter>
+
+    <script src="/site-data.js"></script>
+    <script>
+      const siteData = window.SITE_DATA ?? { pullRequest: null, apps: {} };
+
+      // "Pull request #123: Title" with the title linked to GitHub. Set as text,
+      // never HTML: the title is whatever the PR author typed.
+      function showPullRequest(pullRequest) {
+        if (!pullRequest) return;
+        const line = document.querySelector("#pull-request");
+        line.textContent = `Pull request #${pullRequest.number}: `;
+        if (pullRequest.url) {
+          const link = document.createElement("a");
+          link.href = pullRequest.url;
+          link.textContent = pullRequest.title;
+          line.append(link);
+        } else {
+          line.append(pullRequest.title);
+        }
+      }
+
+      // Each card links to its tool and shows this build's summary. A tool that
+      // wasn't generated keeps its card, unlinked and saying so, and loses its
+      // header link.
+      function showApps(apps) {
+        for (const card of document.querySelectorAll("nys-card[data-app]")) {
+          const app = apps[card.dataset.app];
+          if (app) {
+            card.setAttribute("href", app.href);
+            if (app.summary) card.setAttribute("subheading", app.summary);
+          } else {
+            card.setAttribute("subheading", "Not generated for this build");
+            card.querySelector("nys-icon")?.remove();
+          }
+        }
+        for (const item of document.querySelectorAll("#app-links li")) {
+          if (!apps[item.dataset.app]) item.remove();
+        }
+      }
+
+      showPullRequest(siteData.pullRequest);
+      showApps(siteData.apps);
+    </script>
+    <!-- After the script above, so components upgrade the finished markup. -->
+    <script src="/assets/js/nysds.js"></script>
+  </body>
+</html>
diff --git a/src/scripts/nysds-review/templates/preview.html b/src/scripts/nysds-review/templates/preview.html
new file mode 100644
index 00000000..87d1a963
--- /dev/null
+++ b/src/scripts/nysds-review/templates/preview.html
@@ -0,0 +1,221 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <meta name="robots" content="noindex, nofollow" />
+    <title>NYSDS Component Testing Environment</title>
+    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
+    <link rel="stylesheet" href="/assets/fonts/nysds-fonts.css" />
+    <link rel="stylesheet" href="/assets/css/nysds-full.min.css" />
+    <style>
+      /*
+        Only what @nysds/styles utility classes cannot express (color, borders,
+        weight, case). Layout, spacing and type are utility classes in the
+        markup, and the stylesheet's reset already zeroes heading, paragraph
+        and list margins. Each link is at least 44px tall (--nys-size-550) so
+        it's easy to activate on touch screens.
+      */
+      .nysds-preview-hero {
+        background: var(--nys-color-theme);
+        color: var(--nys-color-text-reverse);
+      }
+      .nysds-preview-eyebrow {
+        font-weight: var(--nys-font-weight-semibold);
+        letter-spacing: 0.08em; /* no token for uppercase label tracking */
+        text-transform: uppercase;
+      }
+      .nysds-preview-hero a,
+      .nysds-preview-hero a:focus,
+      .nysds-preview-hero a:active {
+        color: var(--nys-color-ink-reverse);
+      }
+      .nysds-preview-hero a:focus-visible {
+        outline: var(--nys-border-width-md) solid var(--nys-color-focus-reverse);
+        outline-offset: var(--nys-border-width-md);
+      }
+      .nysds-preview-list li::marker {
+        color: var(--nys-color-text-weak);
+        font-variant-numeric: tabular-nums;
+      }
+      .nysds-preview-list a {
+        min-height: var(--nys-size-550);
+        border-bottom: var(--nys-border-width-sm) solid
+          var(--nys-color-neutral-100);
+      }
+      .nysds-preview-list li:first-child a {
+        border-top: var(--nys-border-width-sm) solid
+          var(--nys-color-neutral-100);
+      }
+      .nysds-preview-list a:hover {
+        background: var(--nys-color-theme-faint);
+      }
+      .nysds-preview-list a:focus-visible {
+        outline: var(--nys-border-width-md) solid var(--nys-color-focus);
+        outline-offset: calc(var(--nys-border-width-md) * -1);
+      }
+      .nysds-preview-vr {
+        background: var(--nys-color-theme-faint);
+        border-bottom: var(--nys-border-width-sm) solid
+          var(--nys-color-neutral-100);
+      }
+      .nysds-preview-vr a {
+        min-height: var(--nys-size-550);
+        font-weight: var(--nys-font-weight-semibold);
+      }
+      .nysds-preview-vr a:focus-visible {
+        outline: var(--nys-border-width-md) solid var(--nys-color-focus);
+        outline-offset: var(--nys-border-width-md);
+      }
+    </style>
+  </head>
+  <body>
+    <!--
+      The accessibility preview's story list, written to /preview/ by
+      build-preview.mjs. pages.js (generated alongside it) lists the stories
+      to test, grouped by component, plus the pull request and the visual
+      regression summary. The script at the bottom fills the page in from it.
+    -->
+    <nys-skipnav></nys-skipnav>
+    <nys-unavheader hideTranslate hideSearch></nys-unavheader>
+    <nys-globalheader appName="NYSDS Review" homepageLink="/">
+      <ul id="app-links">
+        <li data-app="preview">
+          <a href="/preview/">Accessibility Tests</a>
+        </li>
+        <li data-app="visual"><a href="/visual/">Visual Changes</a></li>
+        <li data-app="codeReview">
+          <a href="/code-review/">Codegen Review</a>
+        </li>
+      </ul>
+    </nys-globalheader>
+
+    <main class="nys-grid-container-widescreen">
+      <div class="nys-grid-row">
+        <div class="nys-grid-col-12">
+          <h1 id="story-count">No components to preview</h2>
+          <p id="no-stories">
+            This pull request changes no components with stories.
+          </p>
+          <div id="components"></div>
+        </div>
+      </div>
+    </main>
+    <nys-backtotop></nys-backtotop>
+    <footer>
+      <nys-globalfooter agencyName="NYS Design System" homepageLink="/">
+      </nys-globalfooter>
+      <nys-unavfooter></nys-unavfooter>
+    </footer>
+
+    <!-- One component's stories. Cloned once per component. -->
+    <template id="component-template">
+      <section class="nys-margin-t-400">
+        <h3 class="nys-font-ui-lg" data-field="title"></h3>
+        <ol
+          class="nysds-preview-list nys-font-ui-md nys-margin-t-150 nys-padding-l-600"
+        ></ol>
+      </section>
+    </template>
+
+    <!-- One story link. Cloned once per story. -->
+    <template id="story-template">
+      <li>
+        <a
