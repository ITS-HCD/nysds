# Ignore generated files
dist/
coverage/
release/
*.zip

# Ignore Node-specific files
node_modules/
.npm
npm-debug.log*
*.gz
*.tgz

# Ignore typeScript cache
*.tsbuildinfo

# Ignore eslint cache
.eslintcache

# Ignore Storybook build output
storybook-static/
_site/

# Ignore environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Ignore VSCode directories
*.code-workspace
.vscode-test

# Ignore logs
logs
*.log
*storybook.log
npm-debug.log*

# Ignore temporary and system files
.DS_Store
Thumbs.db

# Turborepo cache
.turbo

# MCP server bundled data (copied at build time)
packages/mcp-server/data/cem/
packages/mcp-server/data/tokens/

# Ignore AI assistant files
CLAUDE.md
.mcp.json
.claude/
.gemini/
docs/

# Framework packages (framework-support plan)
# Interim until WS3: `npm run cem` still writes React wrappers into
# packages/react/, but the output is no longer committed (WS0 task 0.3).
packages/react/*.js
packages/react/*.d.ts
# Generated wrapper sources are rebuilt by `npm run build:all` (decision L5).
packages/react/src/generated/
packages/angular/src/generated/
# Example app build output. dist/ at any depth is covered by the dist/ rule.
examples/*/.angular/
examples/*/.next/
