{
  "name": "@nysds/react",
  "version": "1.20.1",
  "description": "React components for the New York State Design System, generated from the NYSDS web components.",
  "type": "module",
  "license": "MIT",
  "author": "New York State Design System Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/its-hcd/nysds.git",
    "directory": "packages/react"
  },
  "keywords": [
    "new-york-state",
    "design-system",
    "react",
    "web-components",
    "lit",
    "nys"
