{
  "name": "@nysds/tokens",
  "version": "1.22.3",
  "description": "Design tokens for the New York State Design System in DTCG 2025.10 format",
  "type": "module",
  "main": "src/tokens.json",
  "exports": {
    ".": "./src/tokens.json",
    "./json": "./src/tokens.json",
    "./resolver": "./src/resolver.json",
    "./themes/*": "./src/themes/*.json",
    "./css": "./dist/tokens.css"
  },
  "files": [
    "dist/",
    "src/tokens.json",
    "src/resolver.json",
    "src/themes/",
    "css.scss"
  ],
  "scripts": {
    "build": "tz build && node ../../src/scripts/add-banner-tokens.mjs",
    "dev": "tz build --watch",
    "tokens:snapshot": "node scripts/css-diff.mjs snapshot",
    "tokens:compare": "node scripts/css-diff.mjs compare",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@terrazzo/cli": "^2.10.0",
    "@terrazzo/plugin-css": "^2.10.0"
  },
  "keywords": [
    "design-tokens",
    "dtcg",
    "nysds",
    "css-variables",
    "new-york-state",
    "design-system"
  ],
  "author": "New York State Design System Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITS-HCD/nysds.git",
    "directory": "packages/tokens"
  },
  "sideEffects": false
}
