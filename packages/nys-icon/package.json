{
  "name": "@nysds/nys-icon",
  "version": "1.20.1",
  "description": "The Icon component from the NYS Design System.",
  "module": "dist/nys-icon.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nys-icon.js"
    },
    "./nys-icon": {
      "types": "./dist/nys-icon.d.ts",
      "import": "./dist/nys-icon.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "scripts": {
    "dev": "tsc --emitDeclarationOnly && vite",
    "build": "vite build && node src/scripts/extract-icons.mjs",
    "test": "vite build && node src/scripts/extract-icons.mjs && wtr",
    "build:watch": "tsc --emitDeclarationOnly && vite build --watch",
    "test:watch": "vite build && wtr --watch",
    "lit-analyze": "lit-analyzer '**/*.ts'"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "dompurify": "^3.4.7"
  },
  "devDependencies": {
    "@nysds/internals": "^1.20.1",
    "lit": "^3.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "keywords": [
    "new-york-state",
    "design-system",
    "web-components",
    "lit",
    "nys",
    "icon"
  ],
  "author": "New York State Design System Team",
  "license": "MIT",
  "sideEffects": true,
  "peerDependencies": {
    "lit": "^3.3.1"
  }
}
