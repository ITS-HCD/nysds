{
  "name": "@nysds/nys-textinput",
  "version": "1.20.1",
  "description": "The Textinput component from the NYS Design System.",
  "module": "dist/nys-textinput.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nys-textinput.js"
    },
    "./nys-textinput": {
      "types": "./dist/nys-textinput.d.ts",
      "import": "./dist/nys-textinput.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "tsc --emitDeclarationOnly && vite",
    "build": "vite build",
    "test": "vite build && wtr",
    "build:watch": "tsc --emitDeclarationOnly && vite build --watch",
    "test:watch": "vite build && wtr --watch",
    "lit-analyze": "lit-analyzer '**/*.ts'"
  },
  "dependencies": {
    "@nysds/nys-button": "^1.20.1",
    "@nysds/nys-icon": "^1.20.1",
    "@nysds/nys-label": "^1.20.1",
    "@nysds/nys-errormessage": "^1.20.1"
  },
  "devDependencies": {
    "@nysds/internals": "^1.20.1",
    "lit": "^3.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "keywords": [
    "new-york-state",
    "design-system",
    "web-components",
    "lit",
    "nys",
    "input",
    "textinput",
    "forms"
  ],
  "author": "New York State Design System Team",
  "license": "MIT",
  "sideEffects": true,
  "peerDependencies": {
    "lit": "^3.3.1"
  }
}
