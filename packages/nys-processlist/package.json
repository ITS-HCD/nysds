{
  "name": "@nysds/nys-processlist",
  "version": "1.20.1",
  "description": "The Processlist component from the NYS Design System.",
  "module": "dist/nys-processlist.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nys-processlist.js"
    }
  },
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "tsc --emitDeclarationOnly && vite",
    "build": "vite build",
    "test": "vite build && wtr",
    "build:watch": "tsc --emitDeclarationOnly && vite build --watch",
    "test:watch": "vite build && wtr --watch",
    "lit-analyze": "lit-analyzer 'src/**/*.ts'"
  },
  "devDependencies": {
    "@nysds/internals": "^1.20.1",
    "lit": "^3.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "keywords": [
    "new-york-state",
    "design-system",
    "web-components",
    "lit",
    "nys",
    "processlist",
    "forms"
  ],
  "author": "New York State Design System Team",
  "license": "MIT"
}
