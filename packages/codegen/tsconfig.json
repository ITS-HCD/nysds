{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["src/**/*", "cem-plugins/**/*.d.mts"],
  "exclude": ["node_modules", "dist", "test"]
}
