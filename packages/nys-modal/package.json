{
  "name": "@nysds/nys-modal",
  "version": "1.20.1",
  "description": "The Modal component from the NYS Design System.",
  "module": "dist/nys-modal.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nys-modal.js"
    },
    "./nys-modal": {
      "types": "./dist/nys-modal.d.ts",
      "import": "./dist/nys-modal.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "tsc --emitDeclarationOnly && vite",
    "build": "vite build",
    "test": "vite build && wtr",
    "build:watch": "tsc --emitDeclarationOnly && vite build --watch",
    "test:watch": "vite build && wtr --watch"
  },
  "dependencies": {
    "@nysds/nys-button": "^1.20.1"
  },
  "devDependencies": {
    "@nysds/internals": "^1.20.1",
    "lit": "^3.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "keywords": [
    "new-york-state",
    "design-system",
    "web-components",
    "lit",
    "nys",
    "modal",
    "forms"
  ],
  "author": "New York State Design System Team",
  "license": "MIT",
  "sideEffects": true,
  "peerDependencies": {
    "lit": "^3.3.1"
  }
}
